<Window x:Class="CodexQuota.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent" AllowsTransparency="True"
        Width="310" Height="112" ShowActivated="False">
  <Border x:Name="Card" CornerRadius="12" Padding="14" Background="#CC202124" BorderBrush="#55FFFFFF" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="CODEX-KONTINGENT" FontSize="11" Foreground="#BFFFFFFF" FontWeight="SemiBold"/>
      <Grid Grid.Row="1" Margin="0,5,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="5 Stunden" Foreground="#CCFFFFFF" FontSize="12"/><TextBlock x:Name="FiveHourText" Text="–" Foreground="White" FontSize="22" FontWeight="Bold"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="Woche" Foreground="#CCFFFFFF" FontSize="12"/><TextBlock x:Name="WeekText" Text="–" Foreground="White" FontSize="22" FontWeight="Bold"/></StackPanel>
      </Grid>
      <TextBlock x:Name="StatusText" Grid.Row="2" Text="Nicht angemeldet" Foreground="#AAFFFFFF" FontSize="10"/>
    </Grid>
  </Border>
</Window>
