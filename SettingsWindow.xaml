<Window x:Class="CodexQuota.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CodexQuota - Einstellungen" Width="1120" Height="760" MinWidth="980" MinHeight="680" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="Transparent">
  <Window.Resources>
    <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6"/><SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA"/><SolidColorBrush x:Key="PanelBrush" Color="#242424"/><SolidColorBrush x:Key="LineBrush" Color="#383838"/>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/></Style>
    <Style TargetType="Button"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#F3F4F6"/><Setter Property="Padding" Value="14,8"/><Setter Property="Background" Value="#303030"/><Setter Property="BorderBrush" Value="#454545"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#3A3A3A"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="ColorSwatchButton" TargetType="Button"><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#454545"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="SwatchSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#F3F4F6"/></Trigger></Style.Triggers></Style>
    <Style TargetType="CheckBox"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#F3F4F6"/><Setter Property="Margin" Value="0,8"/></Style>
    <Style TargetType="TextBox"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#F3F4F6"/><Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#454545"/><Setter Property="Background" Value="#242424"/></Style>
    <Style TargetType="Slider"><Setter Property="Foreground" Value="#168FE8"/><Setter Property="Background" Value="#17212B"/><Setter Property="Height" Value="22"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="22"><Border Height="8" CornerRadius="4" VerticalAlignment="Center"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#080B0F" Offset="0"/><GradientStop Color="#0C2D46" Offset="0.58"/><GradientStop Color="#168FE8" Offset="1"/></LinearGradientBrush></Border.Background></Border><Track x:Name="PART_Track" VerticalAlignment="Center"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0" Template="{x:Null}"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0" Template="{x:Null}"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb Width="16" Height="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#F4F4F5" Stroke="#6B7280" StrokeThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="CaptionButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Width" Value="46"/><Setter Property="Height" Value="38"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="#D1D5DB"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#303745"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#3A4354"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CloseSurface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="#A52217"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid Background="#171717">
    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#1F2635" MouseLeftButtonDown="Caption_MouseLeftButtonDown"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center"><Border Width="22" Height="22" CornerRadius="6" Background="#6D5DF5"><TextBlock Text="C" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="CodexQuota - Einstellungen" Foreground="#D1D5DB" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="—" Style="{StaticResource CaptionButton}" Click="Minimize_Click"/><Button x:Name="MaximizeButton" Content="□" Style="{StaticResource CaptionButton}" Click="Maximize_Click"/><Button Content="×" Style="{StaticResource CaptionButton}" Click="Close_Click"/></StackPanel></Grid></Border>
    <Border Grid.Row="1" Grid.Column="0" Background="#1C2333" BorderBrush="#30384A" BorderThickness="0,0,1,0"><DockPanel Margin="14,18,14,14">
      <StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="8,0,0,22"><Border Width="34" Height="34" CornerRadius="9" Background="#6D5DF5"><TextBlock Text="C" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="CodexQuota" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Einstellungen" FontSize="11" Foreground="#9CA3AF"/></StackPanel></StackPanel><Border Background="#293145" CornerRadius="8" Padding="12,8" Margin="0,0,0,20"><TextBlock Text="⌕  Einstellungen durchsuchen..." Foreground="#A1A1AA" FontSize="12"/></Border></StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="PERSÖNLICH" Foreground="#7D8493" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,7"/><TextBlock Text="⚙  Allgemein" Background="#343B4D" Padding="10,8" FontWeight="SemiBold"/><TextBlock Text="⇩  Verbindung" Padding="10,8"/><TextBlock Text="◉  Darstellung" Padding="10,8"/><TextBlock Text="◌  Verhalten" Padding="10,8"/><TextBlock Text="◈  Kontingent" Padding="10,8"/><TextBlock Text="⌘  Tastaturkürzel" Padding="10,8"/><TextBlock Text="NUTZUNG" Foreground="#7D8493" FontSize="11" FontWeight="SemiBold" Margin="8,22,0,7"/><TextBlock Text="◷  Aktualisierung" Padding="10,8"/><TextBlock Text="◎  Konto" Padding="10,8"/><TextBlock Text="INTEGRATIONEN" Foreground="#7D8493" FontSize="11" FontWeight="SemiBold" Margin="8,22,0,7"/><TextBlock Text="⊕  System Tray" Padding="10,8"/><TextBlock Text="⌁  Windows" Padding="10,8"/></StackPanel></ScrollViewer>
    </DockPanel></Border>
    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,28,28,40">
      <TextBlock Text="Allgemein" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Verbindung, Darstellung und Verhalten von CodexQuota." Foreground="{StaticResource TextSecondary}" FontSize="14" Margin="0,0,0,28"/>
      <TextBlock Text="VERBINDUNG" Foreground="#A1A1AA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/><Border Background="{StaticResource PanelBrush}" CornerRadius="14" BorderBrush="#383838" BorderThickness="1" Padding="18" Margin="0,0,0,28"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse x:Name="ConnectionDot" Width="12" Height="12" Fill="#888888" VerticalAlignment="Top" Margin="0,5,14,0"/><StackPanel Grid.Column="1"><TextBlock Text="ChatGPT-Verbindung" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Status der gespeicherten Codex-Anmeldung" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0"/><TextBlock x:Name="ConnectionText" Text="Wird geprüft ..." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,10,0,0"/></StackPanel><Button Grid.Column="2" Content="Bei ChatGPT anmelden" Margin="0,0,10,0" VerticalAlignment="Top"/><Button Grid.Column="3" Content="Prüfen" Click="CheckConnection" VerticalAlignment="Top"/></Grid></Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0"><TextBlock Text="DARSTELLUNG" Foreground="#A1A1AA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/><Border Background="{StaticResource PanelBrush}" CornerRadius="14" BorderBrush="#383838" BorderThickness="1" Padding="18"><StackPanel><TextBlock Text="Overlay" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Passe Transparenz, Helligkeit und Farbe der Glasfläche an." Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,16"/><TextBlock Text="Transparenz" Foreground="{StaticResource TextSecondary}" FontSize="12"/><Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,5,0,14"/><TextBlock Text="Hintergrundfarbe" Foreground="{StaticResource TextSecondary}" FontSize="12"/><WrapPanel Margin="0,8,0,4"><Button Tag="#FF202733" Click="ColorSwatch_Click" Background="#202733" Width="26" Height="26" Margin="0,0,7,0"/><Button Tag="#FF334155" Click="ColorSwatch_Click" Background="#334155" Width="26" Height="26" Margin="0,0,7,0"/><Button Tag="#FF1D4ED8" Click="ColorSwatch_Click" Background="#1D4ED8" Width="26" Height="26" Margin="0,0,7,0"/><Button Tag="#FF4F46E5" Click="ColorSwatch_Click" Background="#4F46E5" Width="26" Height="26" Margin="0,0,7,0"/><Button Tag="#FF7C3AED" Click="ColorSwatch_Click" Background="#7C3AED" Width="26" Height="26" Margin="0,0,7,0"/><Button Tag="#FFBE185D" Click="ColorSwatch_Click" Background="#BE185D" Width="26" Height="26" Margin="0,0,7,0"/><Button Tag="#FF047857" Click="ColorSwatch_Click" Background="#047857" Width="26" Height="26" Margin="0,0,7,0"/><Button Tag="#FFB45309" Click="ColorSwatch_Click" Background="#B45309" Width="26" Height="26"/></WrapPanel><TextBox x:Name="BackgroundColorTextBox" Visibility="Collapsed"/></StackPanel></Border></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="VERHALTEN" Foreground="#A1A1AA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/><Border Background="{StaticResource PanelBrush}" CornerRadius="14" BorderBrush="#383838" BorderThickness="1" Padding="18"><StackPanel><TextBlock Text="Start und Bedienung" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Wie CodexQuota gestartet und bedient wird." Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/><CheckBox x:Name="Autostart" Content="Mit Windows starten"/><CheckBox x:Name="ClickThrough" Content="Durchklickmodus aktivieren"/><CheckBox x:Name="AlwaysOnTopCheckBox" Content="Immer im Vordergrund"/><CheckBox x:Name="EditModeCheckBox" Content="Bearbeitungsmodus aktivieren"/></StackPanel></Border></StackPanel>
      </Grid>
      <StackPanel Margin="0,28,0,0"><TextBlock Text="CodexQuota wurde entwickelt von Christoph Andres." Foreground="#A1A1AA" FontSize="12"/><TextBlock Text="Version 1.0" Foreground="#71717A" FontSize="11" Margin="0,2,0,0"/></StackPanel>
    </StackPanel></ScrollViewer>
  </Grid>
</Window>
