<Window x:Class="CodexQuota.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CodexQuota Einstellungen" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" Padding="18">
  <StackPanel Width="350">
    <TextBlock Text="Darstellung" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
    <CheckBox x:Name="Autostart" Content="Mit Windows starten" Margin="0,4"/>
    <CheckBox x:Name="ClickThrough" Content="Durchklickmodus aktivieren" Margin="0,4"/>
    <CheckBox x:Name="Topmost" Content="Immer im Vordergrund" Margin="0,4"/>
    <TextBlock Text="Transparenz" Margin="0,14,0,2"/><Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
    <TextBlock Text="Hintergrundfarbe (z. B. #CC202124)" Margin="0,12,0,2"/><TextBox x:Name="Background"/>
    <Button Content="Speichern" Click="Save" Margin="0,16,0,0" Padding="10,5"/>
  </StackPanel>
</Window>
